<!--suppress CheckTagEmptyBody -->
<bg id='root-object' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>
    <bg id='no-video-bg' height='30' vertical-fit='PreferredSize'>
        <vertical align='Center' vertical-fit='PreferredSize' child-expand-height='false'>
            <text id='no-video-text' align='Center' text="No video configured"></text>
            <button id='search-button' text='Search' on-click='on-search-action'/>
            <button id='turn-on-button' text='Turn on Theater' on-click='on-turn-on-action' active='false'/>
            <!-- Always shown, so Display and its white test for Brightness and Brightness Limit work without a video -->
            <button id='no-video-display-settings-button' text='Display Settings' on-click='on-display-settings-action'/>
        </vertical>
    </bg>
    <bg id='video-details'>
        <vertical child-expand-height="false" spacing="0" vertical-fit="PreferredSize" pad-top="-3" align="top">
            <horizontal preferred-width='116' horizontal-fit='PreferredSize' align="Center"
                        child-expand-width='false'>
                <text id='video-title' font-size='5' align='Center' overflow-mode='Ellipsis' preferred-width='82'
                      text='Video Title'></text>
                <!-- Icon buttons, scaled to half size as one group from its right edge (VideoMenuUI.Initialize).
                     The 34-unit slot fits two ~28-unit buttons at half size; they overflow leftwards before scaling. -->
                <horizontal id='title-buttons' preferred-width='34' min-width='34' spacing='0' child-align='MiddleRight'
                            child-control-width='false' child-control-height='false'
                            child-expand-width='false' child-expand-height='false'>
                    <button-with-icon id='display-settings-button' icon='BeatSaberTheater.Resources.gear.png'
                                      text=' ' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'
                                      hover-hint='Display settings' on-click='on-display-settings-action'/>
                    <button-with-icon id='delete-config-button' icon='BeatSaberTheater.Resources.trash.png'
                                      text=' ' horizontal-fit='PreferredSize' vertical-fit='PreferredSize'
                                      hover-hint='Delete video configuration&#xD;&#xA;&#xD;&#xA;(will also delete the video if downloaded)'
                                      on-click='on-delete-config-action'/>
                </horizontal>
            </horizontal>

            <horizontal horizontal-fit='PreferredSize' vertical-fit='PreferredSize' width='50' height='25'
                        child-expand-width='false' child-expand-height='false'>
                <image id='video-thumbnail' pref-width='40' pref-height='25' preserve-aspect='true'/>
                <vertical align='Top' pad-left='3' spacing='0' pref-width='40' child-expand-width='false'
                          vertical-fit='PreferredSize'>
                    <text id='video-author' font-size='3' align='Left' overflow-mode='Ellipsis'
                          text='Author Name'></text>
                    <text id='video-duration' font-size='3' align='Left' overflow-mode='Ellipsis' text='4:20'></text>
                    <text id='video-status' align='Left' color='red' text='Not downloaded'></text>
                    <button id='delete-video-button' text='Delete Video' on-click='on-delete-video-action'/>
                </vertical>
            </horizontal>

            <vertical pad-top='2'>
                <vertical id="offset-controls">
                    <text id='video-offset-label' align='Center' font-size='3' text='Video Offset'></text>
                    <horizontal horizontal-fit='PreferredSize' align='Center' spacing="1">
                        <button id='offset-decrease-button-high' font-size='3' pref-width='10'
                                hover-hint='Starts video later (-1000 ms)' text='-1s'
                                on-click='on-offset-decrease-action-high'/>
                        <button id='offset-decrease-button-mid' font-size='3' pref-width='10'
                                hover-hint='Starts video later (-100 ms)' text='-100'
                                on-click='on-offset-decrease-action-mid'/>
                        <button id='offset-decrease-button-low' font-size='3' pref-width='10'
                                hover-hint='Starts video later (-20 ms)' text='-20'
                                on-click='on-offset-decrease-action-low'/>
                        <button id='offset-decrease-button-fine' font-size='3' pref-width='10'
                                hover-hint='Starts video later (-5 ms)' text='-5'
                                on-click='on-offset-decrease-action-fine'/>
                        <vertical pref-width='16'>
                            <text id='video-offset' text="0" pad-left='5' pad-right='5' font-size='5'
                                  align='Center'></text>
                        </vertical>
                        <button id='offset-increase-button-fine' font-size='3' pref-width='10'
                                hover-hint='Starts video earlier (+5 ms)' text='+5'
                                on-click='on-offset-increase-action-fine'/>
                        <button id='offset-increase-button-low' font-size='3' pref-width='10'
                                hover-hint='Starts video earlier (+20 ms)' text='+20'
                                on-click='on-offset-increase-action-low'/>
                        <button id='offset-increase-button-mid' font-size='3' pref-width='10'
                                hover-hint='Starts video earlier (+100 ms)' text='+100'
                                on-click='on-offset-increase-action-mid'/>
                        <button id='offset-increase-button-high' font-size='3' pref-width='10'
                                hover-hint='Starts video earlier (+1000 ms)' text='+1s'
                                on-click='on-offset-increase-action-high'/>
                    </horizontal>
                    <modifier-container child-expand-width='true' horizontal-fit='PreferredSize'>
                        <slider-setting id='playback-speed-slider' text='Playback speed' value='playback-speed'
                                        min='0.25' max='2' increment='0.01' show-buttons='true' apply-on-change='true'
                                        formatter='format-speed' get-event='update-customize-offset'
                                        hover-hint='Plays the video faster or slower than the song. 1.00x is normal.'/>
                    </modifier-container>
                </vertical>
                <horizontal id="customize-offset-toggle" preferred-width="45">
                    <bool-setting apply-on-change="true" text='Customize sync' value='customize-offset'
                                  bind-value="true" get-event="update-customize-offset"
                                  hover-hint="Change the offset and speed from the map's video config. Only needed if the video is out of sync for you."></bool-setting>
                </horizontal>
                <horizontal horizontal-fit='PreferredSize' align='Center' spacing='2'>
                    <button id='preview-button' hover-hint='Left ear is the video, right ear is the map' text='Preview'
                            on-click='on-preview-action'/>
                    <button id='auto-sync-button' text='Auto sync' on-click='on-auto-sync-action'
                            hover-hint="Finds the offset by matching the video's sound to the song."/>
                    <button id='revert-offset-button' text='Revert sync' on-click='on-revert-offset-action'
                            hover-hint='Go back to the offset and speed this video had before you changed them.'/>
                </horizontal>
            </vertical>
        </vertical>
        <modal id='auto-sync-modal' show-event='show-auto-sync' hide-event='hide-auto-sync' click-off-closes='false'
               move-to-center='true' size-delta-x='112' size-delta-y='66'>
            <vertical pad='3' spacing='1' child-expand-height='false' child-control-height='true'
                      vertical-fit='PreferredSize' preferred-width='112'>
                <text id='auto-sync-title' font-size='4.5' align='Center' text='Auto sync found 3 matches'/>
                <text id='auto-sync-subtitle' font-size='3' align='Center' word-wrapping='true'
                      text='Current offset: 0 ms'/>
                <vertical id='auto-sync-rows' spacing='1' child-expand-height='false' vertical-fit='PreferredSize'>
                    <!-- Only the best match can show the partial-match note. -->
                    <horizontal id='auto-sync-row-0' preferred-width='106' horizontal-fit='PreferredSize' spacing='2'
                                child-expand-width='false' child-align='MiddleLeft'>
                        <text id='auto-sync-offset-0' font-size='4' align='Left' text='0 ms'/>
                        <vertical preferred-width='46' spacing='0' child-expand-height='false' vertical-fit='PreferredSize'>
                            <text id='auto-sync-tag-0' font-size='3' align='Left' text='SURE'/>
                            <text id='auto-sync-info-0' font-size='2.6' align='Left' text='match 0%'/>
                            <text id='auto-sync-note-0' font-size='2.6' align='Left' color='#F0C85A' text='partial'/>
                        </vertical>
                        <button id='auto-sync-try-0' text='Try' font-size='3' pref-width='13' on-click='on-auto-sync-try-0'/>
                        <button id='auto-sync-apply-0' text='Apply' font-size='3' pref-width='13'
                                on-click='on-auto-sync-apply-0'/>
                    </horizontal>
                    <horizontal id='auto-sync-row-1' preferred-width='106' horizontal-fit='PreferredSize' spacing='2'
                                child-expand-width='false' child-align='MiddleLeft'>
                        <text id='auto-sync-offset-1' font-size='4' align='Left' text='0 ms'/>
                        <vertical preferred-width='46' spacing='0' child-expand-height='false' vertical-fit='PreferredSize'>
                            <text id='auto-sync-tag-1' font-size='3' align='Left' text='SURE'/>
                            <text id='auto-sync-info-1' font-size='2.6' align='Left' text='match 0%'/>
                        </vertical>
                        <button id='auto-sync-try-1' text='Try' font-size='3' pref-width='13' on-click='on-auto-sync-try-1'/>
                        <button id='auto-sync-apply-1' text='Apply' font-size='3' pref-width='13'
                                on-click='on-auto-sync-apply-1'/>
                    </horizontal>
                    <horizontal id='auto-sync-row-2' preferred-width='106' horizontal-fit='PreferredSize' spacing='2'
                                child-expand-width='false' child-align='MiddleLeft'>
                        <text id='auto-sync-offset-2' font-size='4' align='Left' text='0 ms'/>
                        <vertical preferred-width='46' spacing='0' child-expand-height='false' vertical-fit='PreferredSize'>
                            <text id='auto-sync-tag-2' font-size='3' align='Left' text='SURE'/>
                            <text id='auto-sync-info-2' font-size='2.6' align='Left' text='match 0%'/>
                        </vertical>
                        <button id='auto-sync-try-2' text='Try' font-size='3' pref-width='13' on-click='on-auto-sync-try-2'/>
                        <button id='auto-sync-apply-2' text='Apply' font-size='3' pref-width='13'
                                on-click='on-auto-sync-apply-2'/>
                    </horizontal>
                </vertical>
                <button id='auto-sync-close' text='Close' on-click='on-auto-sync-close'/>
            </vertical>
        </modal>
    </bg>

    <bg id='video-search-results'>
        <horizontal pad-top='-3' pad-bottom='8' pad-left="8" pad-right="8">
            <list pad-top='3' id='video-list' list-width='100' visible-cells='6' select-cell='on-select-cell'
                  stick-scrolling="true" show-scrollbar="true"/>
        </horizontal>
        <text id='search-results-loading' active='false' font-size='3' text='Loading Results...' align='Center'
              anchor-pos-y='5'/>
        <modal-keyboard id='search-keyboard' on-enter='on-query' clear-on-open='false' show-event='show-keyboard'
                        hide-event='hide-keyboard' move-to-center='true' click-off-closes='true'/>
        <horizontal pad-top='50'>
            <button text='Go Back' on-click='on-back-action' pad-right="7"/>
            <button id='download-button' text='Download' on-click='on-download-action'/>
            <button id='refine-button' text='Refine Search' on-click='on-refine-action'/>
        </horizontal>
    </bg>

    <!-- Ranges must match Settings/DisplaySettings.cs. -->
    <bg id='display-settings-view' active='false'>
        <vertical child-expand-height='false' spacing='1' vertical-fit='PreferredSize' pad-top='-3' align='top'>
            <text text='Display settings' font-size='5' align='Center' italics='true'/>
            <modifier-container child-expand-width='true' horizontal-fit='PreferredSize'>
                <bool-setting id='display-enabled-setting' text='Theater enabled' value='display-theater-enabled'
                              apply-on-change='true' get-event='refresh-display-values'
                              hover-hint='Turns videos and environment changes on or off.'/>
                <slider-setting id='display-brightness-setting' text='Brightness' value='display-brightness'
                                min='10' max='100' increment='5' integer-only='true' apply-on-change='true'
                                formatter='format-percent' get-event='refresh-display-values'
                                hover-hint='Dims the video and its glow.'/>
                <slider-setting id='display-brightness-limit-setting' text='Brightness Limit' value='display-brightness-limit'
                                min='5' max='100' increment='5' integer-only='true' apply-on-change='true'
                                formatter='format-brightness-limit' get-event='refresh-display-values'
                                hover-hint='Dims bright scenes and flashes so the screen stays below this level. Further left dims more. Off at the far right.'/>
                <slider-setting id='display-size-setting' text='Screen size' value='display-screen-size'
                                min='25' max='300' increment='5' integer-only='true' apply-on-change='true'
                                formatter='format-percent' get-event='refresh-display-values'
                                hover-hint='Only applies in songs, not in the menu.'/>
                <slider-setting id='display-corner-setting' text='Corner roundness' value='display-corner-roundness'
                                min='0' max='100' increment='1' integer-only='true' apply-on-change='true'
                                get-event='refresh-display-values'
                                hover-hint="Rounds the screen's corners. Some maps set their own."/>
                <slider-setting id='display-edge-setting' text='Edge softness' value='display-edge-softness'
                                min='0' max='100' increment='5' integer-only='true' apply-on-change='true'
                                formatter='format-percent' get-event='refresh-display-values'
                                hover-hint="Fades the screen's edges out. Some maps set their own."/>
                <slider-setting id='display-bloom-setting' text='Bloom' value='display-bloom'
                                min='0' max='150' increment='10' integer-only='true' apply-on-change='true'
                                formatter='format-percent' get-event='refresh-display-values'
                                hover-hint='Glow around the screen. 0% turns it off.'/>
            </modifier-container>
            <button text='Back' on-click='on-display-settings-back-action'/>
        </vertical>
    </bg>
</bg>