<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="..\..\BeatSaberTheater\BeatSaberTheater.csproj.user"
            Condition="Exists('..\..\BeatSaberTheater\BeatSaberTheater.csproj.user')" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <BeatSaberDir Condition="'$(BeatSaberDir)' == ''">F:\BSManager\BSInstances\1.40.8</BeatSaberDir>
        <!-- The SDK's net472 reference assemblies come from the local cache during offline restore. -->
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\..\BeatSaberTheater\Sync\**\*.cs" Link="Sync\%(RecursiveDir)%(Filename)%(Extension)" />
        <AssemblyMetadata Include="BeatSaberDir" Value="$(BeatSaberDir)" />
        <Reference Include="Newtonsoft.Json">
            <HintPath>$(BeatSaberDir)\Libs\Newtonsoft.Json.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>

</Project>
